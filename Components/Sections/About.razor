<section id="sobre-mi" class="section about" aria-labelledby="sobre-mi-title">
    <div class="container">
        <SectionHeader Id="sobre-mi-title"
                       Number="01"
                       Eyebrow="Sobre mí"
                       Title="Soluciones robustas, no solo código."
                       Description="Ingeniería, datos y pedagogía al servicio de productos que funcionan y equipos que crecen." />

        <div class="about-grid">
            <div class="about-copy reveal">
                <p class="about-lead">
                    @PortfolioData.Summary
                </p>

                <div class="about-meta">
                    <div class="about-meta-item">
                        <span class="about-meta-label">Enfoque</span>
                        <span class="about-meta-value">Backend · Datos · Multiplataforma</span>
                    </div>
                    <div class="about-meta-item">
                        <span class="about-meta-label">Formación</span>
                        <span class="about-meta-value">Licenciatura en Informática · UASD</span>
                    </div>
                </div>
            </div>

            <div class="about-highlights">
                @foreach (var highlight in Highlights)
                {
                    <article class="highlight-card reveal">
                        <span class="highlight-icon">
                            <Icon Name="@highlight.Icon" Size="20" />
                        </span>
                        <h3>@highlight.Title</h3>
                        <p>@highlight.Description</p>
                    </article>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly (string Icon, string Title, string Description)[] Highlights =
    [
        ("code", "Ingeniería de software", "Sistemas de escritorio, plataformas web y aplicaciones móviles nativas."),
        ("layers", "Arquitectura limpia", "Patrones de diseño, separación de responsabilidades y código mantenible."),
        ("database", "Datos & persistencia", "SQL Server, MariaDB, Entity Framework Core y Room para soluciones robustas."),
        ("graduation", "Docencia & liderazgo", "Experiencia pedagógica para comunicar ideas técnicas con claridad.")
    ];
}
