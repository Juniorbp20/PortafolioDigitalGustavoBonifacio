<section id="habilidades" class="section section--alt skills" aria-labelledby="habilidades-title">
    <div class="container">
        <SectionHeader Id="habilidades-title"
                       Number="02"
                       Eyebrow="Habilidades técnicas"
                       Title="Un stack completo, de la base de datos a la interfaz."
                       Description="Lenguajes, datos, arquitecturas, DevOps e inteligencia artificial aplicados de extremo a extremo." />

        <div class="skills-grid">
            @foreach (var skill in PortfolioData.Skills)
            {
                <SkillGroup Category="skill" />
            }
        </div>
    </div>
</section>
