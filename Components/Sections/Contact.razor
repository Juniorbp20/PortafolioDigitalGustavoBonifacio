<section id="contacto" class="section contact" aria-labelledby="contacto-title">
    <div class="container">
        <div class="contact-panel reveal">
            <div class="contact-copy">
                <p class="section-eyebrow">
                    <span class="section-number">05</span>
                    <span class="section-separator" aria-hidden="true">/</span>
                    <span>Contacto</span>
                </p>
                <h2 id="contacto-title" class="contact-title">
                    ¿Construimos algo
                    <span class="gradient-text">juntos?</span>
                </h2>
                <p class="contact-description">
                    Estoy abierto a oportunidades laborales donde pueda aportar en desarrollo backend, arquitectura de
                    datos, aplicaciones web o desarrollo móvil nativo. Si buscas a alguien que combine criterio técnico,
                    experiencia en .NET y capacidad para comunicar ideas, hablemos.
                </p>
                <p class="contact-availability">
                    <span class="status-dot" aria-hidden="true"></span>
                    Abierto a oportunidades laborales
                </p>
            </div>

            <div class="contact-actions">
                <a class="btn btn-primary btn-lg" href="mailto:@PortfolioData.Email">
                    <Icon Name="mail" Size="19" />
                    Escríbeme
                    <Icon Name="arrow-up-right" Size="16" />
                </a>
                <a class="btn btn-ghost btn-lg" href="@PortfolioData.GitHubUrl" target="_blank" rel="noopener noreferrer">
                    <Icon Name="github" Size="19" />
                    Ver GitHub
                </a>
            </div>
        </div>

        <div class="contact-methods">
            <a class="contact-method reveal" href="mailto:@PortfolioData.Email">
                <span class="contact-method-icon">
                    <Icon Name="mail" Size="20" />
                </span>
                <span class="contact-method-copy">
                    <span class="contact-method-label">Email</span>
                    <span class="contact-method-value">@PortfolioData.Email</span>
                </span>
                <span class="contact-method-arrow">
                    <Icon Name="arrow-up-right" Size="18" />
                </span>
            </a>

            <a class="contact-method reveal" href="@PortfolioData.GitHubUrl" target="_blank" rel="noopener noreferrer">
                <span class="contact-method-icon">
                    <Icon Name="github" Size="20" />
                </span>
                <span class="contact-method-copy">
                    <span class="contact-method-label">GitHub</span>
                    <span class="contact-method-value">@PortfolioData.GitHubHandle</span>
                </span>
                <span class="contact-method-arrow">
                    <Icon Name="arrow-up-right" Size="18" />
                </span>
            </a>

            <button class="contact-method contact-method--button reveal"
                    type="button"
                    data-copy-email
                    data-copy-value="@PortfolioData.Email"
                    aria-label="Copiar correo electrónico @PortfolioData.Email">
                <span class="contact-method-icon">
                    <Icon Name="copy" Size="20" />
                </span>
                <span class="contact-method-copy">
                    <span class="contact-method-label">Copiar correo</span>
                    <span class="contact-method-value" data-copy-label>@PortfolioData.Email</span>
                </span>
                <span class="contact-method-check">
                    <Icon Name="check" Size="18" />
                </span>
            </button>
        </div>
    </div>
</section>
