@page "/not-found"
@layout MainLayout

<PageTitle>Página no encontrada | Gustavo Bonifacio</PageTitle>

<section class="error-page" aria-labelledby="not-found-title">
    <div class="container">
        <div class="error-card">
            <p class="section-eyebrow">
                <span class="section-number">404</span>
                <span class="section-separator" aria-hidden="true">/</span>
                <span>Página no encontrada</span>
            </p>
            <h1 id="not-found-title">Esta página no existe.</h1>
            <p class="error-description">
                Es posible que el enlace haya cambiado o que la dirección esté incompleta.
                Puedes volver al inicio y continuar explorando el portafolio.
            </p>
            <div class="error-actions">
                <a class="btn btn-primary" href="/">Volver al inicio</a>
                <a class="btn btn-ghost" href="/#proyectos">Ver proyectos</a>
            </div>
        </div>
    </div>
</section>
