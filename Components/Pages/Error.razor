@page "/Error"

<PageTitle>Error | Gustavo Bonifacio</PageTitle>

<section class="error-page" aria-labelledby="error-title">
    <div class="container">
        <div class="error-card">
            <p class="section-eyebrow">
                <span class="section-number">!</span>
                <span class="section-separator" aria-hidden="true">/</span>
                <span>Error</span>
            </p>
            <h1 id="error-title">Algo salió mal.</h1>
            <p class="error-description">
                No pudimos procesar esta solicitud. Intenta recargar la página o vuelve al inicio.
            </p>

            <div class="error-actions">
                <a class="btn btn-primary" href="/">Volver al inicio</a>
                <a class="btn btn-ghost" href=".">Recargar página</a>
            </div>
        </div>
    </div>
</section>

