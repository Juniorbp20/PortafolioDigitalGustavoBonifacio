    <meta name="description" content="Portafolio profesional de Gustavo Junior Bonifacio Peña, desarrollador de software especializado en .NET, C#, arquitectura de bases de datos, Blazor y desarrollo de aplicaciones." />
    <meta name="author" content="Gustavo Junior Bonifacio Peña" />
